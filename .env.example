# Copie para .env.local e preencha. O .env.local NUNCA vai para o Git.

# Supabase (contas e login): supabase.com > seu projeto > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave que criptografa a senha da Intelbras guardada neste computador (gere com: openssl rand -hex 32)
LIVEON_LOCAL_KEY=

# Chave da API da Claude para o chat de análises (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Gemini (Google AI Studio, plano grátis) — só para testes; a Claude tem prioridade se ANTHROPIC_API_KEY estiver preenchida.
GEMINI_API_KEY=
